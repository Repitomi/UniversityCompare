// Complete DAX Calculation Suite for EHEDP

// 1. Total Attendees
Total Attendees =
SUM ( YearlyMetrics[attendees] )

// 2. Total Graduates
Total Graduates =
SUM ( YearlyMetrics[graduates] )

// 3. Overall Completion Rate
Completion Rate =
DIVIDE (
    [Total Graduates],
    [Total Attendees],
    0
)

// 4. Prior Year Attendees
Total Attendees PY =
CALCULATE (
    [Total Attendees],
    SAMEPERIODLASTYEAR ( Calendar[Date] )
)

// 5. Attendees YoY Growth %
Attendees YoY Growth % =
VAR CurrentVal = [Total Attendees]
VAR PriorVal   = [Total Attendees PY]
RETURN
    DIVIDE ( CurrentVal - PriorVal, PriorVal, 0 )

// 6. Dynamic University Page Header
Dynamic University Title =
VAR SelectedUni =
    SELECTEDVALUE ( University[name], "All European Universities" )
VAR SelectedYear =
    SELECTEDVALUE ( YearlyMetrics[academic_year], "Multi-Year View" )
RETURN
    "Performance Review: " & SelectedUni & " (" & SelectedYear & ")"

// 7. Conditional Formatting Rules for Matrix Views
Department Growth Status =
VAR Growth = [Attendees YoY Growth %]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Growth ), "#CCCCCC",  -- Neutral Gray (No prior year)
        Growth > 0.05,      "#107C41",  -- Soft Green (>5% Growth)
        Growth < -0.05,     "#A80000",  -- Soft Red (<-5% Decline)
        "#D13438"                       -- Amber / Flat
    )
